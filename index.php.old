$nStartSongID = rand(1,29);

/*
 ********************************************************************************
 * getSongID()
 * 
 * This function returns the song ID based on a start song ID and an offset.
 ********************************************************************************
*/
function getSongID($nStartID, $nOffset)
{
	if(($nStartID + $nOffset) > 29)
	{
		$nSongID = ($nStartID + $nOffset) - 29;
	}
	else
	{
		$nSongID = $nStartID + $nOffset;
	}
	
	return $nSongID;
}

/*
 ********************************************************************************
 * renderSongLink()
 * 
 * This function renders the HTML for a song based on its offset
 ********************************************************************************
*/
function renderSongLink($nStartID, $nOffset)
{
	global $ROOT;
	global $oSongs;
		
	$nSongID = getSongID($nStartID, $nOffset);
	$nSongIndex = $nSongID-1;
	
	if (!empty($oSongs->aSongRecords[$nSongIndex]->sVideoLink) || !empty($oSongs->aSongRecords[$nSongIndex]->sArtImage) ||!empty($oSongs->aSongRecords[$nSongIndex]->sDropImage) )
	{
		$sImage = $nSongID . "Color.jpg";
	}
	else
	{
		$sImage = $nSongID . ".jpg";
	}
	
	//echo "<a href=\"{$ROOT}/song.php?song={$nSongID}\"><img src=\"" . IMG_DIR . "/{$sImage}\" border=\"0\" /></a>";
	echo "<a href=\"{$ROOT}/song.php?song={$nSongID}\">{$nSongID}</a>";
}
